// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


// ─── ENUMS ───────────────────────────────────────────

enum Rol {
  ADMIN
  CAJERO
  CLIENTE
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA_QR
}

enum EstadoOrden {
  PENDIENTE
  PAGADO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

// ─── IDENTIDAD ───────────────────────────────────────

model Usuario {
  id       Int      @id @default(autoincrement())
  nombre   String
  apellido String
  email    String   @unique
  password String
  rol      Rol
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  cliente Cliente?
  ventas  Venta[]
  cajas   Caja[]
}

model Cliente {
  id        Int     @id @default(autoincrement())
  telefono  String
  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  direcciones Direccion[]
  carrito     Carrito?
  ordenes     Orden[]
}

model Direccion {
  id          Int     @id @default(autoincrement())
  calle       String
  ciudad      String
  referencias String?
  clienteId   Int
  cliente     Cliente @relation(fields: [clienteId], references: [id])
}

// ─── CATÁLOGO E INVENTARIO ───────────────────────────

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
}

model Producto {
  id            Int      @id @default(autoincrement())
  nombre        String
  descripcion   String?
  costo         Decimal  @db.Decimal(10, 2)
  precioVenta   Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  categoriaId   Int
  categoria     Categoria @relation(fields: [categoriaId], references: [id])

  detallesVenta DetalleVenta[]
  detallesOrden DetalleOrden[]
  itemsCarrito  ItemCarrito[]
}

// ─── POS Y CAJA ──────────────────────────────────────

model Caja {
  id                  Int        @id @default(autoincrement())
  montoInicial        Decimal    @db.Decimal(10, 2)
  montoFinalDeclarado Decimal?   @db.Decimal(10, 2)
  estado              EstadoCaja @default(ABIERTA)
  abiertaEn           DateTime   @default(now())
  cerradaEn           DateTime?
  usuarioId           Int
  usuario             Usuario    @relation(fields: [usuarioId], references: [id])

  ventas Venta[]
}

model Venta {
  id         Int        @id @default(autoincrement())
  fecha      DateTime   @default(now())
  total      Decimal    @db.Decimal(10, 2)
  metodoPago MetodoPago
  cajaId     Int
  caja       Caja       @relation(fields: [cajaId], references: [id])
  cajeroId   Int
  cajero     Usuario    @relation(fields: [cajeroId], references: [id])

  detalles DetalleVenta[]
}

model DetalleVenta {
  id             Int      @id @default(autoincrement())
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
}

// ─── TIENDA ONLINE Y ÓRDENES ─────────────────────────

model Carrito {
  id            Int      @id @default(autoincrement())
  actualizadoEn DateTime @updatedAt
  clienteId     Int      @unique
  cliente       Cliente  @relation(fields: [clienteId], references: [id])

  items ItemCarrito[]
}

model ItemCarrito {
  id         Int      @id @default(autoincrement())
  cantidad   Int
  carritoId  Int
  carrito    Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([carritoId, productoId])
}

model Orden {
  id               Int         @id @default(autoincrement())
  fecha            DateTime    @default(now())
  total            Decimal     @db.Decimal(10, 2)
  estado           EstadoOrden @default(PENDIENTE)
  nombreContacto   String
  telefonoContacto String
  direccionEnvio   String
  referencias      String?
  clienteId        Int?
  cliente          Cliente?    @relation(fields: [clienteId], references: [id])

  detalles DetalleOrden[]
}

model DetalleOrden {
  id             Int      @id @default(autoincrement())
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  ordenId        Int
  orden          Orden    @relation(fields: [ordenId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
}